configuration {
  font: "JetBrainsMono Nerd Font 11";
}
* {
  bg: #1e1e2e;
  fg: #cdd6f4;
  accent: #cba6f7;
  background-color: transparent;
  text-color: @fg;
}
window {
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 8px;
  width: 40%;
  padding: 12px;
}
inputbar { padding: 8px; }
prompt { text-color: @accent; }
element { padding: 6px; }
element selected.normal {
  background-color: @accent;
  text-color: @bg;
}
